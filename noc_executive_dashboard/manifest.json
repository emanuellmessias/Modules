{
	"manifest_version": 2.0,
	"id": "noc_executive_dashboard",
	"name": "NOC Executive Dashboard",
	"version": "1.0.0",
	"namespace": "NocExecutiveDashboard",
	"author": "NOC Team",
	"description": "Dashboard executivo para o NOC no estilo do SOC: indicadores de automacao (WhatsApp, Email, Cervello) vs acoes humanas (grupo Monitor), MTTD/MTTA/MTTR e visao multi-tenant por grupo de hosts.",
	"actions": {
		"noc.executive.overview": {
			"class": "ExecutiveOverview",
			"view": "noc.executive.overview"
		},
		"noc.executive.data": {
			"class": "ExecutiveData",
			"layout": "layout.json"
		}
	},
	"widgets": [],
	"config": {
		"automation_mediatypes": ["WhatsApp", "Email HTML NOC Betta", "Chamado Cervello"],
		"mediatype_whatsapp": "WhatsApp",
		"mediatype_email": "Email HTML NOC Betta",
		"mediatype_cervello": "Chamado Cervello",
		"human_user_group": "Monitor",
		"tenant_separator": "|"
	}
}
